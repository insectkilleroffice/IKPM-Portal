{
  "name": "ikpm-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:security": "tsx src/tests/securityVerification.test.ts",
    "backfill:folders": "tsx scripts/backfillFolders.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "preview": "vite preview",
    "test:rules": "npx --yes firebase-tools@14 emulators:exec --only firestore --project demo-ikpm \"vitest run src/tests/rulesEmulator.test.ts\""
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "^1.59.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "9.3.10",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^14.5.0",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
