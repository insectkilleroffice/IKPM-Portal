rules_version = '2';

// IKPM Portal security rules.
// Mirrors src/lib/permissions.ts: each collection lists the roles that may use it, and
// records are scoped to the owner / their team unless the user has company-wide scope.
//
// Deploy with:  npx firebase-tools deploy --only firestore:rules,firestore:indexes
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identity helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function me() {
      return get(profilePath()).data;
    }

    // An active portal user with a profile created by the super admin (or the bootstrap)
    function active() {
      return hasProfile() && me().get('isActive', false) == true;
    }

    function role() {
      return me().role;
    }

    function hasRole(roles) {
      return active() && role() in roles;
    }

    function isSuperAdmin() {
      return hasRole(['super_admin']);
    }

    // Super admin, management and auditors see every record; others only if given company scope
    function seesAll() {
      return active() && (role() in ['super_admin', 'management', 'auditor'] || me().get('dataScope', 'own') == 'company');
    }

    function myTeam() {
      return me().get('teamId', '__no_team__');
    }

    // Record-level scope check for reads/updates of existing documents
    function inScope(data) {
      return seesAll()
        || data.ownerUid == request.auth.uid
        || (me().get('dataScope', 'own') == 'team' && data.teamId == myTeam());
    }

    // New records must be stamped with the creator (company-wide users may create on behalf of others)
    function ownsNew() {
      return seesAll() || request.resource.data.get('ownerUid', '') == request.auth.uid;
    }

    // Ownership fields can't be reassigned by scoped users
    function keepsOwner() {
      return seesAll() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid', 'teamId']);
    }

    function readScoped(roles) {
      return hasRole(roles) && inScope(resource.data);
    }

    function createScoped(roles) {
      return hasRole(roles) && ownsNew();
    }

    function updateScoped(roles) {
      return hasRole(roles) && inScope(resource.data) && keepsOwner();
    }

    // ---------- System bootstrap ----------
    // Readable by anyone so the login page knows whether first-admin setup is needed.
    match /system_config/{configId} {
      allow read: if true;
      // Only the account that just created its own super_admin profile can lock initialization.
      allow create: if configId == 'initialization'
        && signedIn()
        && !exists(/databases/$(database)/documents/system_config/initialization)
        && request.resource.data.superAdminUid == request.auth.uid
        && get(profilePath()).data.role == 'super_admin';
      allow update, delete: if isSuperAdmin();
    }

    // ---------- Staff accounts & teams ----------
    match /users/{userId} {
      allow read: if active() || (signedIn() && request.auth.uid == userId);
      // Super admin provisions staff. The very first super admin may create itself before initialization.
      allow create: if isSuperAdmin() || (
        signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'super_admin'
        && !exists(/databases/$(database)/documents/system_config/initialization)
      );
      // Users may edit their own name/avatar/phone, never their access fields.
      allow update: if isSuperAdmin() || (
        signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['role', 'dataScope', 'isActive', 'teamId', 'teamName', 'businessEmail', 'email'])
      );
      allow delete: if isSuperAdmin();
    }

    match /teams/{teamId} {
      allow read: if active();
      allow write: if isSuperAdmin();
    }

    // ---------- Customers ----------
    match /companies/{id} {
      allow read: if readScoped(['super_admin', 'management', 'sales', 'operations', 'finance', 'auditor']);
      allow create: if createScoped(['super_admin', 'management', 'sales', 'operations']);
      allow update: if updateScoped(['super_admin', 'management', 'sales', 'operations']);
      allow delete: if isSuperAdmin();
    }

    match /branches/{id} {
      allow read: if readScoped(['super_admin', 'management', 'sales', 'operations', 'finance', 'auditor']);
      allow create: if createScoped(['super_admin', 'management', 'sales', 'operations']);
      allow update: if updateScoped(['super_admin', 'management', 'sales', 'operations']);
      allow delete: if isSuperAdmin();
    }

    match /clients/{id} {
      allow read: if readScoped(['super_admin', 'management', 'sales', 'operations', 'finance', 'auditor']);
      allow create: if createScoped(['super_admin', 'management', 'sales', 'operations']);
      allow update: if updateScoped(['super_admin', 'management', 'sales', 'operations']);
      allow delete: if isSuperAdmin();
    }

    match /sites/{id} {
      allow read: if readScoped(['super_admin', 'management', 'sales', 'operations', 'finance', 'auditor']);
      allow create: if createScoped(['super_admin', 'management', 'sales', 'operations']);
      allow update: if updateScoped(['super_admin', 'management', 'sales', 'operations']);
      allow delete: if isSuperAdmin();
    }

    // ---------- Sales pipeline ----------
    match /leads/{id} {
      allow read: if readScoped(['super_admin', 'management', 'sales', 'auditor']);
      allow create: if createScoped(['super_admin', 'management', 'sales']);
      allow update: if updateScoped(['super_admin', 'management', 'sales']);
      allow delete: if isSuperAdmin();
    }

    match /proposals/{id} {
      allow read: if readScoped(['super_admin', 'management', 'sales', 'auditor']);
      allow create: if createScoped(['super_admin', 'management', 'sales']);
      allow update: if updateScoped(['super_admin', 'management', 'sales']);
      allow delete: if isSuperAdmin();
    }

    match /contracts/{id} {
      allow read: if readScoped(['super_admin', 'management', 'sales', 'operations', 'finance', 'auditor']);
      allow create: if createScoped(['super_admin', 'management', 'sales', 'operations']);
      allow update: if updateScoped(['super_admin', 'management', 'sales', 'operations']);
      allow delete: if isSuperAdmin();
    }

    // ---------- Field operations ----------
    match /service_jobs/{id} {
      allow read: if readScoped(['super_admin', 'management', 'operations', 'finance', 'auditor'])
        || (hasRole(['technician']) && request.auth.uid in resource.data.assignedTechnicianIds);
      allow create: if createScoped(['super_admin', 'management', 'operations', 'sales']);
      allow update: if updateScoped(['super_admin', 'management', 'operations'])
        || (hasRole(['technician'])
            && request.auth.uid in resource.data.assignedTechnicianIds
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
              ['ownerUid', 'teamId', 'assignedTechnicianIds', 'customerId', 'contractId']));
      allow delete: if hasRole(['super_admin', 'management']);
    }

    // ---------- Finance ----------
    match /invoices/{id} {
      allow read: if hasRole(['super_admin', 'management', 'finance', 'auditor']);
      allow create: if hasRole(['super_admin', 'management', 'finance']);
      // Posted invoices are immutable except for a credit-note reversal
      allow update: if hasRole(['super_admin', 'management', 'finance']) && (
        resource.data.get('isPosted', false) != true || request.resource.data.status == 'void_reversed'
      );
      allow delete: if false;
    }

    match /payments/{id} {
      allow read: if hasRole(['super_admin', 'management', 'finance', 'auditor']);
      allow create: if hasRole(['super_admin', 'management', 'finance']);
      allow update, delete: if false;
    }

    match /tax_rules/{id} {
      allow read: if active();
      allow write: if hasRole(['super_admin', 'management', 'finance']);
    }

    // ---------- Documents (files live in Cloudinary) ----------
    match /documents/{id} {
      allow read: if (hasRole(['super_admin', 'management', 'sales', 'operations', 'finance', 'auditor'])
          && (resource.data.owner.kind == 'library' || inScope(resource.data)))
        || (hasRole(['technician']) && resource.data.ownerUid == request.auth.uid);
      allow create: if active() && role() != 'auditor' && request.resource.data.get('ownerUid', '') == request.auth.uid;
      allow update: if hasRole(['super_admin', 'management', 'sales', 'operations', 'finance'])
        && (resource.data.owner.kind == 'library' || inScope(resource.data)) && keepsOwner();
      allow delete: if hasRole(['super_admin', 'management']);
    }

    match /document_packs/{id} {
      allow read: if active();
      allow write: if hasRole(['super_admin', 'management']);
    }

    // ---------- Outreach & audit (append-only) ----------
    match /outreach_logs/{id} {
      allow read: if readScoped(['super_admin', 'management', 'sales', 'auditor']);
      allow create: if active() && request.resource.data.sentBy == request.auth.token.email
        && request.resource.data.get('ownerUid', '') == request.auth.uid;
      allow update, delete: if false;
    }

    match /audit_logs/{id} {
      allow read: if hasRole(['super_admin', 'management', 'auditor']);
      allow create: if active() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
