rules_version = '2';

// IKPM Portal security rules.
// Permissions are data: each staff profile (users/{uid}) names a role, and roles/{roleId}
// gives every module an access level ('none' | 'view' | 'edit'). The super admin edits roles on
// the Team & Access page; these rules read the same documents, so the server enforces exactly
// what the portal shows. Records are also scoped to their owner / team unless the person has
// company-wide data access. Mirrors src/lib/permissions.ts.
//
// Deploy with:  npx firebase-tools deploy --only firestore
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identity ----------
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function me() {
      return get(profilePath()).data;
    }

    function active() {
      return signedIn() && exists(profilePath()) && me().get('isActive', false) == true;
    }

    function role() {
      return me().role;
    }

    function isSuperAdmin() {
      return active() && role() == 'super_admin';
    }

    // ---------- Role-based module access ----------
    function access(module) {
      return get(/databases/$(database)/documents/roles/$(role())).data.get('modules', {}).get(module, 'none');
    }

    function canView(module) {
      return isSuperAdmin() || (active() && access(module) in ['view', 'edit']);
    }

    function canEdit(module) {
      return isSuperAdmin() || (active() && access(module) == 'edit');
    }

    // ---------- Record scope ----------
    function seesAll() {
      return isSuperAdmin() || (active() && me().get('dataScope', 'own') == 'company');
    }

    function myTeam() {
      return me().get('teamId', '__no_team__');
    }

    function inScope(data) {
      return seesAll()
        || data.ownerUid == request.auth.uid
        || (me().get('dataScope', 'own') == 'team' && data.teamId == myTeam());
    }

    function ownsNew() {
      return seesAll() || request.resource.data.get('ownerUid', '') == request.auth.uid;
    }

    function keepsOwner() {
      return seesAll() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid', 'teamId']);
    }

    // Standard business collection guarded by one module
    function readMod(module) {
      return canView(module) && inScope(resource.data);
    }

    function createMod(module) {
      return canEdit(module) && ownsNew();
    }

    function updateMod(module) {
      return canEdit(module) && inScope(resource.data) && keepsOwner();
    }

    // ---------- System bootstrap ----------
    match /system_config/{configId} {
      allow read: if true;
      allow create: if configId == 'initialization'
        && signedIn()
        && !exists(/databases/$(database)/documents/system_config/initialization)
        && request.resource.data.superAdminUid == request.auth.uid
        && get(profilePath()).data.role == 'super_admin';
      // Company letterhead (name, NTN, bank details, logo) used on generated documents
      allow create: if configId == 'company_profile' && isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // ---------- Roles (customizable permissions) ----------
    match /roles/{roleId} {
      allow read: if signedIn();
      // Super admin, or a role granted "Customize roles". Nobody but the super admin can touch super_admin.
      allow write: if isSuperAdmin() || (roleId != 'super_admin' && canEdit('roles'));
    }

    // ---------- Staff accounts & teams ----------
    match /users/{userId} {
      allow read: if active() || (signedIn() && request.auth.uid == userId);
      allow create: if isSuperAdmin()
        || (canEdit('team') && request.resource.data.role != 'super_admin')
        || (
          // First super admin bootstrap (only before initialization)
          signedIn() && request.auth.uid == userId
          && request.resource.data.role == 'super_admin'
          && !exists(/databases/$(database)/documents/system_config/initialization)
        );
      allow update: if isSuperAdmin()
        || (
          // Staff managers can edit other non-super-admin people, never promote to super admin
          canEdit('team') && userId != request.auth.uid
          && resource.data.role != 'super_admin' && request.resource.data.role != 'super_admin'
        )
        || (
          // Anyone may edit their own name / phone / last login, never their access
          signedIn() && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ['role', 'dataScope', 'isActive', 'teamId', 'teamName', 'businessEmail', 'email'])
        );
      allow delete: if isSuperAdmin();
    }

    match /teams/{teamId} {
      allow read: if active();
      allow write: if canEdit('team');
    }

    // ---------- Customers ----------
    match /companies/{id} {
      allow read: if readMod('customers');
      allow create: if createMod('customers');
      allow update: if updateMod('customers');
      allow delete: if isSuperAdmin();
    }

    match /branches/{id} {
      allow read: if readMod('customers');
      allow create: if createMod('customers');
      allow update: if updateMod('customers');
      allow delete: if isSuperAdmin();
    }

    match /clients/{id} {
      allow read: if readMod('customers');
      allow create: if createMod('customers');
      allow update: if updateMod('customers');
      allow delete: if isSuperAdmin();
    }

    match /sites/{id} {
      allow read: if readMod('customers');
      allow create: if createMod('customers');
      allow update: if updateMod('customers');
      allow delete: if isSuperAdmin();
    }

    // ---------- Sales pipeline ----------
    function assignedInspector() {
      return request.auth.uid in resource.data.inspectorIds;
    }

    match /leads/{id} {
      allow read: if readMod('crm') || (canView('inspections') && assignedInspector());
      allow create: if createMod('crm');
      // Assigned inspectors may record findings, but not reassign the lead or change its contacts
      allow update: if updateMod('crm')
        || (canEdit('inspections') && assignedInspector()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
              ['ownerUid', 'teamId', 'inspectorIds', 'contacts', 'companyName', 'title', 'customerType', 'existingCustomerId']));
      allow delete: if isSuperAdmin();
    }

    match /proposals/{id} {
      allow read: if readMod('proposals');
      allow create: if createMod('proposals');
      allow update: if updateMod('proposals');
      allow delete: if isSuperAdmin();
    }

    match /contracts/{id} {
      allow read: if readMod('contracts');
      allow create: if createMod('contracts');
      allow update: if updateMod('contracts');
      allow delete: if isSuperAdmin();
    }

    // ---------- Field operations ----------
    match /service_jobs/{id} {
      allow read: if readMod('jobs')
        || (canView('pco') && request.auth.uid in resource.data.assignedTechnicianIds);
      // Contracts generate their visit schedule, so contract editors may create jobs too
      allow create: if (canEdit('jobs') || canEdit('contracts')) && ownsNew();
      allow update: if updateMod('jobs')
        || (canEdit('pco')
            && request.auth.uid in resource.data.assignedTechnicianIds
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
              ['ownerUid', 'teamId', 'assignedTechnicianIds', 'customerId', 'contractId']));
      allow delete: if isSuperAdmin();
    }

    // ---------- Finance ----------
    match /invoices/{id} {
      allow read: if canView('invoices');
      allow create: if canEdit('invoices');
      // Posted invoices are immutable except for a credit-note reversal
      allow update: if canEdit('invoices') && (
        resource.data.get('isPosted', false) != true || request.resource.data.status == 'void_reversed'
      );
      allow delete: if false;
    }

    match /payments/{id} {
      allow read: if canView('invoices');
      allow create: if canEdit('invoices');
      allow update, delete: if false;
    }

    match /tax_rules/{id} {
      allow read: if active();
      allow write: if canEdit('tax');
    }

    // ---------- Documents (files live in Cloudinary) ----------
    match /documents/{id} {
      allow read: if (canView('documents') && resource.data.owner.kind == 'library')
        || (canView('files') && inScope(resource.data))
        || (active() && resource.data.ownerUid == request.auth.uid);
      allow create: if active()
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && (canEdit('files') || canEdit('documents') || canEdit('pco') || canEdit('proposals'));
      allow update: if ((canEdit('documents') && resource.data.owner.kind == 'library')
          || (canEdit('files') && inScope(resource.data)))
        && keepsOwner();
      allow delete: if isSuperAdmin();
    }

    match /document_packs/{id} {
      allow read: if active();
      allow write: if canEdit('documents');
    }

    // ---------- Outreach & audit (append-only) ----------
    match /outreach_logs/{id} {
      allow read: if (canView('crm') || canView('proposals') || canView('documents')) && inScope(resource.data);
      allow create: if active() && request.resource.data.sentBy == request.auth.token.email
        && request.resource.data.get('ownerUid', '') == request.auth.uid;
      allow update, delete: if false;
    }

    // "Scan to verify" records behind document QR codes: anyone holding the link can read one,
    // nobody can list them, and only active staff can write them
    match /doc_verifications/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if active();
      allow delete: if isSuperAdmin();
    }

    match /audit_logs/{id} {
      allow read: if canView('settings');
      allow create: if active() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
