rules_version = '2';

// IKPM Portal security rules.
// Permissions are data: each staff profile (users/{uid}) names a role, and roles/{roleId} gives every
// module an access level ('none' | 'view' | 'edit'). The super admin edits roles (and per-person access
// profiles) on the Team & Access page; these rules read the same documents, so the server enforces
// exactly what the portal shows. Records are also scoped to their owner / team unless the person has
// company-wide data access. Mirrors src/lib/permissions.ts.
//
// PERFORMANCE: Firestore evaluates at most 1000 expressions per request and refuses the request when
// that budget runs out. Every rule therefore reads the caller ONCE through who() and passes that map
// ("w") to the small helpers below, instead of re-reading the profile / role document and rebuilding
// the default-permission table for every check.
//
// Deploy with:  npx firebase-tools deploy --only firestore
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Who is calling (read once per request) ----------
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function signedIn() {
      return request.auth != null;
    }

    // { active, role, rk (role key, old ids mapped), base (built-in role it is based on), mods, scope, team }
    function who() {
      let ok = request.auth != null && exists(profilePath());
      let p = ok ? get(profilePath()).data : {};
      let r = p.get('role', '');
      let rk = r == 'operations_coordinator' ? 'team_leader' : (r == 'operations_manager' ? 'operations' : r);
      let rp = /databases/$(database)/documents/roles/$(rk == '' ? '_none' : rk);
      let rd = ok && rk != '' && exists(rp) ? get(rp).data : {};
      return {
        'active': ok && p.get('isActive', false) == true,
        'role': r,
        'rk': rk,
        'base': rd.get('basedOn', rk),
        'mods': rd.get('modules', {}),
        'hasDoc': 'modules' in rd,
        'scope': p.get('dataScope', 'own'),
        'team': p.get('teamId', '__no_team__'),
        // Staff who also do quality audits (any role, e.g. a CRO)
        'ento': p.get('isEntomologist', false) == true
      };
    }

    // Built-in default levels (mirror DEFAULT_ROLES in src/lib/permissions.ts). Used only for a module
    // the saved role document doesn't list, exactly as the portal merges them.
    function defaultModulesFor(r) {
      return r == 'admin'
        ? {'dashboard':'edit','customers':'edit','crm':'edit','inspections':'edit','proposals':'edit',
          'contracts':'edit','files':'edit','documents':'edit','company_files':'edit','calendar':'edit',
          'jobs':'edit','pco':'edit','complaints':'edit','challans':'edit','attendance':'edit',
          'hr':'edit','team':'edit','payroll':'view','search':'edit','invoices':'view','settings':'view','approvals':'view','roles':'view'}
        : r == 'sales'
        ? {'dashboard':'edit','customers':'edit','crm':'edit','proposals':'edit','contracts':'edit',
          'pco':'edit','files':'edit','complaints':'edit','documents':'view','company_files':'view','approvals':'view'}
        : (r == 'operations' || r == 'operations_manager')
        ? {'dashboard':'edit','customers':'edit','inspections':'edit','contracts':'edit','calendar':'edit',
          'jobs':'edit','pco':'edit','files':'edit','complaints':'edit','challans':'edit','attendance':'edit',
          'search':'edit','crm':'view','proposals':'view','documents':'view','company_files':'view','hr':'view'}
        : (r == 'team_leader' || r == 'operations_coordinator')
        ? {'dashboard':'edit','inspections':'edit','jobs':'edit','pco':'edit','complaints':'edit',
          'challans':'edit','attendance':'edit','search':'edit','calendar':'edit','company_files':'view'}
        : r == 'technician'
        ? {'dashboard':'view','jobs':'view','pco':'edit','attendance':'view'}
        : r == 'entomologist'
        ? {'dashboard':'edit','customers':'edit','crm':'edit','proposals':'edit','contracts':'edit',
          'pco':'edit','files':'edit','complaints':'edit','audits':'edit','documents':'view','company_files':'view','approvals':'view'}
        : r == 'finance'
        ? {'dashboard':'view','invoices':'edit','tax':'view','payroll':'edit',
          'challans':'view','search':'edit','documents':'view','contracts':'view','customers':'view','complaints':'view','jobs':'view'}
        : r == 'auditor'
        ? {'dashboard':'view','audit_logs':'view','complaints':'view'}
        : r == 'hr'
        ? {'dashboard':'view','hr':'edit','attendance':'view','payroll':'view',
          'team':'view','documents':'view','search':'view'}
        : r == 'management'
        ? {'dashboard':'edit','customers':'edit','crm':'edit','inspections':'edit','proposals':'edit',
          'contracts':'edit','files':'edit','documents':'edit','company_files':'edit','calendar':'edit',
          'jobs':'edit','pco':'edit','complaints':'edit','settings':'view','approvals':'edit'}
        : {};
    }

    // Access level for a module: the saved role document's level, else the built-in default
    function lvl(w, m) {
      return m in w.mods ? w.mods[m] : defaultModulesFor(w.rk).get(m, 'none');
    }

    function isSA(w) {
      return w.active && w.role == 'super_admin';
    }

    function canV(w, m) {
      return isSA(w) || (w.active && lvl(w, m) in ['view', 'edit']);
    }

    function canE(w, m) {
      return isSA(w) || (w.active && lvl(w, m) == 'edit');
    }

    // Built-in role checks go by the role a role is based on (custom and personal roles included)
    function isSupervisor(w) {
      return w.active && (w.rk == 'team_leader' || w.base == 'team_leader');
    }

    function isOpsManager(w) {
      return w.active && (w.rk == 'operations' || w.base == 'operations');
    }

    function isBase(w, b) {
      return w.active && (w.rk == b || w.base == b);
    }

    // ---------- Record scope ----------
    // The Operations Manager oversees all operations work, so the role always has company-wide access.
    function seesAll(w) {
      return isSA(w) || (w.active && (w.scope == 'company' || isOpsManager(w)));
    }

    // Direct field reads (data.ownerUid, data.teamId) so list queries filtered on them can be proven
    function inScope(w, data) {
      return seesAll(w)
        || data.ownerUid == request.auth.uid
        || (w.scope == 'team' && data.teamId == w.team);
    }

    function ownsNew(w) {
      return seesAll(w) || request.resource.data.get('ownerUid', '') == request.auth.uid;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function keepsOwner(w) {
      return seesAll(w) || !changed().hasAny(['ownerUid', 'teamId']);
    }

    // ---------- Virtual folders (src/lib/folders.ts) ----------
    // Records carry ownerScope ('company' = IKPM's own, 'client') and clientId. Once set they never
    // change, except when a lead becomes a customer: its records move from clientId = lead id to the
    // customer account the lead now points at (leads/{id}.existingCustomerId).
    function leadConversion() {
      return resource.data.get('ownerScope', '') == 'client'
        && request.resource.data.get('ownerScope', '') == 'client'
        && exists(/databases/$(database)/documents/leads/$(resource.data.clientId))
        && get(/databases/$(database)/documents/leads/$(resource.data.clientId)).data.get('existingCustomerId', '') == request.resource.data.get('clientId', '');
    }

    function folderOwnerKept() {
      return (!('ownerScope' in resource.data) || request.resource.data.get('ownerScope', null) == resource.data.ownerScope)
        && (!('clientId' in resource.data) || request.resource.data.get('clientId', null) == resource.data.clientId || leadConversion());
    }

    // Folder fields only: filing an unfiled record, or the lead → customer move
    function filingOnly(w) {
      return w.active
        && changed().hasOnly(['ownerScope', 'clientId', 'clientType', 'branchId', 'folderPath', 'fileCategory', 'folderMovedFrom', 'updatedAt'])
        && (!('folderPath' in resource.data) || leadConversion())
        && folderOwnerKept();
    }

    // Standard business collection guarded by one module
    function readMod(w, m) {
      return canV(w, m) && inScope(w, resource.data);
    }

    function createMod(w, m) {
      return canE(w, m) && ownsNew(w);
    }

    function updateMod(w, m) {
      return canE(w, m) && inScope(w, resource.data) && keepsOwner(w) && folderOwnerKept();
    }

    // ---------- System bootstrap ----------
    match /system_config/{configId} {
      allow read: if true;
      allow create: if configId == 'initialization'
        && signedIn()
        && !exists(/databases/$(database)/documents/system_config/initialization)
        && request.resource.data.superAdminUid == request.auth.uid
        && get(profilePath()).data.role == 'super_admin';
      // Company letterhead (name, NTN, bank details, logo) used on generated documents
      allow create: if (configId == 'company_profile' || configId == 'document_templates') && isSA(who());
      allow update, delete: if isSA(who());
    }

    // ---------- Document templates: every save is a new version, never overwritten ----------
    // Wording (cover letter, scope, SOP): super admin + 'templates' edit. Commercial / legal: super admin.
    function templateCreate(w, vid) {
      return w.active
        && request.resource.data.savedByUid == request.auth.uid
        && vid == request.resource.data.kind + '_v' + string(request.resource.data.version)
        && (
          (request.resource.data.kind == 'wording'
            && (isSA(w) || w.mods.get('templates', w.rk == 'management' ? 'edit' : 'none') == 'edit')
            && request.resource.data.data.keys().hasOnly(['coverLetter', 'scopeSections', 'sopSections']))
          || (request.resource.data.kind == 'commercial' && isSA(w))
        );
    }

    match /template_versions/{vid} {
      allow read: if who().active;
      allow create: if templateCreate(who(), vid);
      allow update, delete: if false;
    }

    // ---------- Roles (customizable permissions + personal access profiles) ----------
    match /roles/{roleId} {
      allow read: if signedIn();
      // Super admin, or a role granted "Customize roles". Nobody but the super admin can touch super_admin.
      allow write: if isSA(who()) || (roleId != 'super_admin' && canE(who(), 'roles'));
    }

    // ---------- Staff accounts & teams ----------
    function userCreate(w, userId) {
      return isSA(w)
        || (canE(w, 'team') && request.resource.data.role != 'super_admin')
        || (
          // First super admin bootstrap (only before initialization)
          signedIn() && request.auth.uid == userId
          && request.resource.data.role == 'super_admin'
          && !exists(/databases/$(database)/documents/system_config/initialization)
        );
    }

    function userUpdate(w, userId) {
      return isSA(w)
        // Staff managers can edit other non-super-admin people, never promote to super admin
        || (canE(w, 'team') && userId != request.auth.uid
            && resource.data.role != 'super_admin' && request.resource.data.role != 'super_admin')
        // Anyone may edit their own name / phone / last login, never their access
        || (signedIn() && request.auth.uid == userId
            && !changed().hasAny(['role', 'dataScope', 'isActive', 'teamId', 'teamName', 'businessEmail', 'email', 'isEntomologist']));
    }

    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || who().active;
      allow create: if userCreate(who(), userId);
      allow update: if userUpdate(who(), userId);
      allow delete: if isSA(who());
    }

    match /teams/{teamId} {
      allow read: if who().active;
      allow write: if canE(who(), 'team');
    }

    // ---------- Customers ----------
    match /companies/{id} {
      // Anyone signed in may look up an id that doesn't exist yet (new-number check, reveals nothing)
      allow get: if signedIn() && resource == null;
      allow read: if readMod(who(), 'customers');
      allow create: if createMod(who(), 'customers');
      allow update: if updateMod(who(), 'customers');
      allow delete: if isSA(who());
    }

    match /branches/{id} {
      allow read: if readMod(who(), 'customers');
      allow create: if createMod(who(), 'customers');
      allow update: if updateMod(who(), 'customers');
      allow delete: if isSA(who());
    }

    match /clients/{id} {
      // Anyone signed in may look up an id that doesn't exist yet (new-number check, reveals nothing)
      allow get: if signedIn() && resource == null;
      allow read: if readMod(who(), 'customers');
      allow create: if createMod(who(), 'customers');
      allow update: if updateMod(who(), 'customers');
      allow delete: if isSA(who());
    }

    match /sites/{id} {
      allow read: if readMod(who(), 'customers');
      allow create: if createMod(who(), 'customers');
      allow update: if updateMod(who(), 'customers');
      allow delete: if isSA(who());
    }

    // ---------- Sales pipeline ----------
    // "Assigned to me" checks read fields directly so the matching list queries can be proven
    // (inspectorIds array-contains / assignedTeamLeaderId == / siteInspection.teamLeaderId ==).
    function leadAssignedToMe() {
      return request.auth.uid in resource.data.inspectorIds
        || resource.data.assignedTeamLeaderId == request.auth.uid
        || resource.data.siteInspection.teamLeaderId == request.auth.uid
        || request.auth.uid in resource.data.siteInspection.assignedTechIds;
    }

    function leadRead(w) {
      return readMod(w, 'crm')
        || isOpsManager(w)
        || (canV(w, 'pco') && inScope(w, resource.data))
        || ((canV(w, 'inspections') || canV(w, 'pco') || isSupervisor(w)) && leadAssignedToMe());
    }

    // Meeting / inspection fields: what assigning, scheduling and reporting a visit may change
    function meetingFieldsOnly() {
      return changed().hasOnly(['inspection', 'inspectorIds', 'assignedTeamLeaderId', 'assignedTeamLeaderName',
        'stage', 'activities', 'updatedAt', 'siteInspection', 'branches', 'pestIssues', 'stuckAt', 'stuckAtDate',
        // recalculated on every save (same phone / email as another lead)
        'duplicateWarning']);
    }

    function leadUpdate(w) {
      return updateMod(w, 'crm')
        // A CRO forwards their own lead to another CRO: owner fields and the activity log entry only
        || (canE(w, 'crm') && resource.data.get('ownerUid', '') == request.auth.uid
            && request.resource.data.get('ownerUid', '') != request.auth.uid
            && changed().hasOnly(['ownerUid', 'ownerName', 'ownerEmail', 'teamId', 'assignedToUserId', 'assignedToName', 'activities', 'updatedAt']))
        // Assigned inspectors record findings, but can't reassign the lead or change its contacts
        || (canE(w, 'inspections') && request.auth.uid in resource.data.get('inspectorIds', [])
            && !changed().hasAny(['ownerUid', 'teamId', 'inspectorIds', 'contacts', 'companyName', 'title', 'customerType', 'existingCustomerId']))
        // Operations Manager (or anyone with field + inspection / dispatch access): assign and schedule
        // meetings and site inspections on any lead, meeting fields only
        || ((isOpsManager(w) || (canV(w, 'pco') && canE(w, 'inspections')) || canE(w, 'jobs')) && meetingFieldsOnly())
        // Site inspection team: findings only
        || ((canE(w, 'inspections') || isSupervisor(w))
            && (request.auth.uid == resource.data.get('siteInspection', {}).get('teamLeaderId', '')
                || request.auth.uid in resource.data.get('siteInspection', {}).get('assignedTechIds', []))
            && changed().hasOnly(['siteInspection', 'activities', 'updatedAt', 'stage', 'pestIssues', 'branches', 'duplicateWarning']));
    }

    match /leads/{id} {
      allow read: if leadRead(who());
      allow create: if createMod(who(), 'crm');
      allow update: if leadUpdate(who());
      allow delete: if isSA(who());
    }

    match /proposals/{id} {
      // Anyone signed in may look up an id that doesn't exist yet (new-number check, reveals nothing)
      allow get: if signedIn() && resource == null;
      allow read: if readMod(who(), 'proposals');
      allow create: if createMod(who(), 'proposals');
      allow update: if updateMod(who(), 'proposals') || (canE(who(), 'proposals') && filingOnly(who()));
      allow delete: if isSA(who());
    }

    function contractUpdate(w) {
      return updateMod(w, 'contracts')
        || (canE(w, 'contracts') && filingOnly(w))
        // Schedule generator / dispatch: job counters and Supervisor / Ops Manager assignment only
        || ((canE(w, 'contracts') || canE(w, 'jobs') || isOpsManager(w)) && keepsOwner(w) && folderOwnerKept()
            && changed().hasOnly(['totalJobsScheduled', 'totalJobsCompleted',
                                  'assignedTeamLeaderId', 'assignedTeamLeaderName',
                                  'assignedOperationsManagerId', 'assignedOperationsManagerName', 'assignedAt',
                                  'isRenewalInitiated', 'renewalAlertDate', 'updatedAt']))
        // Supervisor closing a visit: only the completed-visit counter changes
        || (isSupervisor(w) && changed().hasOnly(['totalJobsCompleted', 'updatedAt']));
    }

    match /contracts/{id} {
      // Anyone signed in may look up an id that doesn't exist yet (new-number check, reveals nothing)
      allow get: if signedIn() && resource == null;
      // Assigned Supervisors may read their own contracts even if company scope is restricted
      allow read: if readMod(who(), 'contracts')
        || ((canV(who(), 'pco') || isSupervisor(who())) && resource.data.assignedTeamLeaderId == request.auth.uid);
      allow create: if createMod(who(), 'contracts');
      allow update: if contractUpdate(who());
      allow delete: if isSA(who());
    }

    // ---------- Field operations ----------
    // The Supervisor on a job (assignedTeamLeaderId, also in assignedTechnicianIds) runs it in the field
    // and submits the report. PCOs have no login; they are HR employee ids on the job.
    // Older jobs stored the Supervisor's HR employee id (EMP-…, whose record points at their login uid).
    function isMyEmployeeId(empId) {
      return empId is string && empId.matches('^EMP-[A-Za-z0-9-]+$')
        && exists(/databases/$(database)/documents/employees/$(empId))
        && get(/databases/$(database)/documents/employees/$(empId)).data.get('uid', '') == request.auth.uid;
    }

    // Direct field reads first, so "my jobs" queries can be proven
    function onMyJob() {
      return request.auth.uid in resource.data.assignedTechnicianIds
        || resource.data.assignedTeamLeaderId == request.auth.uid
        || resource.data.leadPcoId == request.auth.uid
        || isMyEmployeeId(resource.data.get('assignedTeamLeaderId', ''))
        || isMyEmployeeId(resource.data.get('leadPcoId', ''));
    }

    // Field steps: starting a visit (scheduled → in progress) and closing it out (in progress → completed).
    // QC sending a completed report back (completed → in progress) is not a field step.
    function isFieldStep() {
      return request.resource.data.get('status', '') != resource.data.get('status', '')
        && resource.data.get('status', '') in ['scheduled', 'en_route', 'in_progress']
        && request.resource.data.get('status', '') in ['in_progress', 'completed'];
    }

    function jobUpdate(w) {
      // Field steps: the job's Supervisor, any Supervisor covering for them, or the CEO
      return (!isFieldStep() || isSupervisor(w) || isSA(w) || onMyJob()) && (
        updateMod(w, 'jobs')
        || ((canE(w, 'jobs') || canE(w, 'contracts')) && filingOnly(w))
        // The Supervisor on the job runs the visit, whatever their saved module levels; they can't
        // reassign, refile or change the customer
        // (a Supervisor may also cover a colleague's visit)
        || ((isSupervisor(w) || ((canE(w, 'pco') || canE(w, 'jobs')) && onMyJob()))
            && !changed().hasAny(['ownerUid', 'teamId', 'assignedTechnicianIds', 'assignedTeamLeaderId', 'customerId', 'contractId',
                                  'ownerScope', 'clientId', 'clientType', 'branchId', 'folderPath', 'fileCategory'])));
    }

    match /service_jobs/{id} {
      allow read: if readMod(who(), 'jobs') || ((canV(who(), 'pco') || isSupervisor(who())) && onMyJob());
      // Contracts generate their visit schedule, so contract editors may create jobs too
      allow create: if (canE(who(), 'jobs') || canE(who(), 'contracts')) && ownsNew(who());
      allow update: if jobUpdate(who());
      allow delete: if isSA(who());
    }

    // Device register: customer editors and dispatch maintain it; the field app reads it.
    match /devices/{id} {
      allow read: if canV(who(), 'customers') || canV(who(), 'jobs') || canV(who(), 'pco');
      allow create, update: if canE(who(), 'customers') || canE(who(), 'jobs');
      allow delete: if isSA(who());
    }

    // Monitoring sheets: one record per device per visit, written on the job (also offline) or by dispatch.
    match /monitoring_records/{id} {
      allow read: if canV(who(), 'customers') || canV(who(), 'jobs') || canV(who(), 'pco');
      allow create, update: if (canE(who(), 'pco') || canE(who(), 'jobs') || isSupervisor(who()))
        && request.resource.data.recordedByUid == request.auth.uid
        && id == request.resource.data.jobId + '_' + request.resource.data.deviceId;
      allow delete: if isSA(who());
    }

    // ---------- Finance ----------
    // Invoices are approved by an admin or the super admin (mirrors canApproveInvoices in src/lib/permissions.ts)
    function isInvoiceApprover(w) {
      return isSA(w) || isBase(w, 'admin');
    }

    // Finance prepares drafts only: draft → pending approval. Only an approver can post / approve an
    // invoice or return it with a reason (a returned invoice may be edited as long as it stays returned).
    function invoiceDraftOnly() {
      return request.resource.data.get('isPosted', false) != true
        && request.resource.data.get('isApproved', false) != true
        && (request.resource.data.get('status', 'draft') in ['draft', 'pending_approval']
            || (request.resource.data.get('status', '') == 'rejected' && resource != null
                && resource.data.get('status', '') == 'rejected'
                && !changed().hasAny(['rejectedBy', 'rejectedAt', 'rejectionReason'])));
    }

    function invoiceForCancelledContract() {
      return request.resource.data.get('contractId', '') != ''
        && exists(/databases/$(database)/documents/contracts/$(request.resource.data.get('contractId', '')))
        && get(/databases/$(database)/documents/contracts/$(request.resource.data.get('contractId', ''))).data.get('status', '') == 'cancelled';
    }

    function invoiceUpdate(w) {
      // Unposted: drafts by Finance, anything by an approver.
      // Posted invoices are immutable except for a credit-note reversal or recording payment settlement
      return (canE(w, 'invoices') || isBase(w, 'admin')) && folderOwnerKept() && (
        (resource.data.get('isPosted', false) != true && (invoiceDraftOnly() || isInvoiceApprover(w)))
          || (request.resource.data.status == 'void_reversed'
              && !changed().hasAny(['ownerScope', 'clientId', 'folderPath', 'fileCategory']))
          || (request.resource.data.status in ['paid', 'partially_paid', 'posted', 'issued', 'sent']
              && !changed().hasAny(['ownerScope', 'clientId', 'folderPath', 'fileCategory', 'lineItems', 'subtotal',
                                    'grossPayable', 'taxTotal', 'invoiceNumber', 'customerId']))
      );
    }

    // Client statements: one per contract billing period. Finance prepares, resubmits, cancels,
    // records payments and sends; only an admin / super admin approves (numbers it) or rejects.
    function statementUpdate(w) {
      return (canE(w, 'invoices') || isBase(w, 'admin')) && (
        isInvoiceApprover(w)
        || (!changed().hasAny(['statementNumber', 'approvedBy', 'approvedAt', 'rejectedBy', 'rejectedAt', 'rejectionReason'])
            && (request.resource.data.status == resource.data.status
                || (resource.data.status in ['draft', 'rejected'] && request.resource.data.status == 'pending_approval')
                || (resource.data.status in ['draft', 'pending_approval', 'rejected'] && request.resource.data.status == 'cancelled'))));
    }

    match /client_statements/{id} {
      allow get: if signedIn() && resource == null;
      allow read: if canV(who(), 'invoices');
      allow create: if (canE(who(), 'invoices') || isBase(who(), 'admin'))
        && (isInvoiceApprover(who()) || request.resource.data.get('status', 'draft') in ['draft', 'pending_approval']);
      allow update: if statementUpdate(who());
      allow delete: if false;
    }

    match /invoices/{id} {
      // Anyone signed in may look up an id that doesn't exist yet (new-number check, reveals nothing)
      allow get: if signedIn() && resource == null;
      allow read: if canV(who(), 'invoices');
      // New invoices start as drafts; only an approver may create one already approved / posted.
      // A cancelled contract is invoiced only by the super admin (its settlement).
      allow create: if (canE(who(), 'invoices') || isBase(who(), 'admin'))
        && (!invoiceForCancelledContract() || isSA(who()))
        && (isInvoiceApprover(who())
            || (request.resource.data.get('isPosted', false) != true
                && request.resource.data.get('isApproved', false) != true
                && request.resource.data.get('status', 'draft') in ['draft', 'pending_approval']));
      allow update: if invoiceUpdate(who());
      allow delete: if false;
    }

    match /payments/{id} {
      // Anyone signed in may look up an id that doesn't exist yet (new-number check, reveals nothing)
      allow get: if signedIn() && resource == null;
      allow read: if canV(who(), 'invoices');
      allow create: if canE(who(), 'invoices') || isBase(who(), 'admin');
      // Receipts never change, apart from being filed into their client's folder, or the WHT
      // certificate number being added when the client sends it (the amounts stay the same)
      allow update: if canE(who(), 'invoices') && (filingOnly(who())
        || (changed().hasOnly(['customerWhtDeducted'])
            && request.resource.data.customerWhtDeducted.amountDeducted == resource.data.customerWhtDeducted.amountDeducted
            && request.resource.data.customerWhtDeducted.ratePercent == resource.data.customerWhtDeducted.ratePercent
            && request.resource.data.customerWhtDeducted.isApplicable == resource.data.customerWhtDeducted.isApplicable));
      allow delete: if false;
    }

    match /tax_rules/{id} {
      allow read: if who().active;
      allow write: if canE(who(), 'tax');
    }

    // ---------- Documents (files live in Cloudinary) ----------
    // Company (IKPM) files are the documents owned by the library (owner.kind == 'library', ownerScope
    // 'company'); every other owner kind is a client file. Queries filter on owner.kind.
    function ownerKind(d) {
      return d.get('owner', {}).get('kind', 'legacy');
    }

    function isClientKind(d) {
      return ownerKind(d) in ['company', 'client', 'branch', 'lead', 'proposal', 'job', 'legacy'];
    }

    function scopeMatchesOwner(d) {
      return (ownerKind(d) == 'library' && d.get('ownerScope', 'company') == 'company')
        || (isClientKind(d) && d.get('ownerScope', 'client') == 'client');
    }

    // Role documents saved before company_files existed fall back to the old 'documents' level;
    // a built-in role with no saved document uses its default
    function companyFiles(w) {
      return w.hasDoc
        ? w.mods.get('company_files', w.mods.get('documents', 'none'))
        : defaultModulesFor(w.rk).get('company_files', 'none');
    }

    function documentRead(w) {
      return (ownerKind(resource.data) == 'library' && (isSA(w) || (w.active && companyFiles(w) in ['view', 'edit'])))
        || (isClientKind(resource.data) && canV(w, 'files') && inScope(w, resource.data))
        || (isClientKind(resource.data) && w.active && resource.data.ownerUid == request.auth.uid);
    }

    function documentCreate(w) {
      return w.active
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && 'owner' in request.resource.data
        && scopeMatchesOwner(request.resource.data)
        && (
          (request.resource.data.owner.kind == 'library' && (isSA(w) || companyFiles(w) == 'edit'))
          || (isClientKind(request.resource.data) && request.resource.data.owner.kind != 'legacy'
              // Finance files invoice / receipt PDFs; Supervisors file signed challans and photos
              && (canE(w, 'files') || canE(w, 'pco') || canE(w, 'proposals') || canE(w, 'crm')
                  || canE(w, 'inspections') || canE(w, 'invoices') || isSupervisor(w)))
        );
    }

    function documentUpdate(w) {
      return keepsOwner(w) && folderOwnerKept() && scopeMatchesOwner(request.resource.data) && (
        (ownerKind(resource.data) == 'library' && ownerKind(request.resource.data) == 'library' && (isSA(w) || companyFiles(w) == 'edit'))
        || (isClientKind(resource.data) && isClientKind(request.resource.data) && canE(w, 'files') && inScope(w, resource.data))
        // Re-submitting a visit report replaces the challan file the Supervisor uploaded
        || (isClientKind(resource.data) && isClientKind(request.resource.data)
            && isSupervisor(w) && resource.data.get('ownerUid', '') == request.auth.uid)
        || (isClientKind(resource.data) && filingOnly(w))
      );
    }

    match /documents/{id} {
      allow read: if documentRead(who());
      allow create: if documentCreate(who());
      allow update: if documentUpdate(who());
      allow delete: if isSA(who());
    }

    // Packs list document ids only (no file content); everyone sending documents reads them.
    function packWrite(w, scope) {
      return (scope == 'company' && (isSA(w) || companyFiles(w) == 'edit')) || (scope == 'client' && canE(w, 'files'));
    }

    match /document_packs/{id} {
      allow read: if who().active;
      allow create: if packWrite(who(), request.resource.data.get('ownerScope', 'company'));
      allow update: if folderOwnerKept()
        && (packWrite(who(), resource.data.get('ownerScope', 'company')) || filingOnly(who()));
      allow delete: if isSA(who());
    }

    // ---------- Approvals ----------
    // Managers (edit) see all; requesters (view) see only their own. Nobody decides their own request.
    match /approvals/{id} {
      allow read: if canV(who(), 'approvals')
        && (canE(who(), 'approvals') || resource.data.ownerUid == request.auth.uid);
      // The requester files their own request; approvers may file a missing one on the requester's behalf
      allow create: if who().active
        && (request.resource.data.ownerUid == request.auth.uid
            || (canE(who(), 'approvals') && request.resource.data.ownerUid != request.auth.uid));
      allow update: if canE(who(), 'approvals') && resource.data.ownerUid != request.auth.uid;
      allow delete: if isSA(who());
    }

    // ---------- Complaints ----------
    match /complaints/{id} {
      // Anyone signed in may look up an id that doesn't exist yet (new-number check, reveals nothing)
      allow get: if signedIn() && resource == null;
      allow read: if readMod(who(), 'complaints');
      allow create: if createMod(who(), 'complaints');
      allow update: if canE(who(), 'complaints') && inScope(who(), resource.data) && keepsOwner(who());
      allow delete: if isSA(who());
    }

    // ---------- Outreach & audit (append-only) ----------
    match /outreach_logs/{id} {
      allow read: if (canV(who(), 'crm') || canV(who(), 'proposals') || canV(who(), 'documents')) && inScope(who(), resource.data);
      allow create: if who().active && request.resource.data.sentBy == request.auth.token.email
        && request.resource.data.get('ownerUid', '') == request.auth.uid;
      // Messages never change, apart from being filed into (or moving with) their client's folder
      allow update: if filingOnly(who());
      allow delete: if false;
    }

    // "Scan to verify" records behind document QR codes: readable by id only
    match /doc_verifications/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if who().active;
      allow delete: if isSA(who());
    }

    // ---------- Quality audits (entomologist visits) ----------
    // The super admin schedules, verifies, returns and sends; the entomologist sees only their own
    // audits (never surprise details for anyone else) and can only fill in and submit the report.
    function isEntomologist(w) {
      return w.active && w.ento;
    }

    match /quality_audits/{id} {
      allow get: if signedIn() && resource == null;
      // The person it is assigned to (direct field read, so their "my audits" query can be proven)
      allow read: if isSA(who()) || (who().active && resource.data.entomologistUid == request.auth.uid);
      allow create: if isSA(who())
        && get(/databases/$(database)/documents/users/$(request.resource.data.entomologistUid)).data.get('isEntomologist', false) == true;
      allow update: if isSA(who())
        || (who().active && resource.data.entomologistUid == request.auth.uid
            && resource.data.status in ['scheduled', 'returned']
            && request.resource.data.status in ['scheduled', 'returned', 'submitted']
            && changed().hasOnly(['report', 'status', 'submittedAt', 'updatedAt']));
      allow delete: if false;
    }

    // ---------- Physical challan numbers: one job per number ----------
    // Doc id = the normalised number. Taking a number that another job holds is refused; a job may
    // release its own number (jobId '') when its challan number changes.
    match /challan_numbers/{key} {
      allow get: if who().active;
      allow list: if false;
      allow create: if (canE(who(), 'challans') || canE(who(), 'jobs') || isSupervisor(who()))
        && request.resource.data.jobId is string && request.resource.data.jobId != '';
      allow update: if (canE(who(), 'challans') || canE(who(), 'jobs') || isSupervisor(who()))
        && (resource.data.get('jobId', '') == ''
            || resource.data.jobId == request.resource.data.get('jobId', '')
            || (request.resource.data.get('jobId', '') == '' && resource.data.jobId == request.resource.data.get('releasedFrom', '')));
      allow delete: if isSA(who());
    }

    // ---------- Challans ----------
    match /challans/{id} {
      allow read: if canV(who(), 'challans') || canV(who(), 'jobs') || canV(who(), 'invoices');
      allow create, update: if canE(who(), 'challans') || canE(who(), 'jobs') || isSupervisor(who());
      allow delete: if false; // Challans are permanent, never deleted
    }

    // ---------- HR & Employee records ----------
    // Public to staff: basic directory info (name, role, status, phone, photo)
    match /employees/{id} {
      allow read: if who().active;
      allow create, update: if canE(who(), 'hr');
      allow delete: if false; // Status is set to inactive, never hard deleted
    }

    // Sensitive HR data (CNIC, bank account, address, witnesses): HR and the CEO only.
    // Checked by role, not module level, so giving another role 'hr' edit never exposes it.
    function isHrOrCeo(w) {
      return isSA(w) || isBase(w, 'hr');
    }

    match /employee_private/{id} {
      allow read: if isHrOrCeo(who());
      allow create, update: if isHrOrCeo(who());
      allow delete: if false;
    }

    // Employee letters (offer, employment contract, confirmation): they print pay and CNIC,
    // so HR and the CEO only. Issued letters are never deleted (withdrawn instead).
    match /employee_letters/{id} {
      allow read: if isHrOrCeo(who());
      allow create, update: if isHrOrCeo(who());
      allow delete: if false;
    }

    // Salary structure & pay data: Finance, HR and the CEO
    match /employee_pay/{id} {
      allow read: if canV(who(), 'payroll') || canE(who(), 'hr');
      allow create, update: if canE(who(), 'payroll') || canE(who(), 'hr');
      allow delete: if false;
    }

    // 30-day payroll cycles
    match /salary_cycles/{id} {
      allow read: if canV(who(), 'payroll') || canE(who(), 'hr');
      allow create, update: if canE(who(), 'payroll');
      allow delete: if isSA(who());
    }

    // Payroll collection alias
    match /payroll/{id} {
      allow read: if canV(who(), 'payroll') || canE(who(), 'hr');
      allow create, update: if canE(who(), 'payroll') || canE(who(), 'hr');
      allow delete: if isSA(who());
    }

    // HR collection alias
    match /hr/{id} {
      allow read: if who().active;
      allow create, update: if canE(who(), 'hr');
      allow delete: if false;
    }

    // Daily attendance
    function attendanceRead(w) {
      return canV(w, 'attendance') || canV(w, 'hr') || canV(w, 'payroll')
        || (isBase(w, 'technician') && resource.data.get('employeeId', '') == get(profilePath()).data.get('employeeId', ''));
    }

    match /attendance/{id} {
      allow read: if attendanceRead(who());
      allow create, update: if canE(who(), 'attendance') || canE(who(), 'jobs') || isSupervisor(who());
      allow delete: if isSA(who());
    }

    // Safe ID counters
    match /id_counters/{key} {
      allow read: if who().active;
      allow create: if who().active;
      // Counters only move forward (they may jump to catch up with numbers already in use)
      allow update: if who().active && request.resource.data.seq is int && request.resource.data.seq > resource.data.seq;
      allow delete: if isSA(who());
    }

    // Lets the portal check which rules are live (dataService.rulesAreCurrent). Change this id
    // together with RULES_VERSION in src/services/dataService.ts whenever the rules change.
    match /rules_probe/{version} {
      allow get: if version == '2026-11-05-a';
    }

    match /audit_logs/{id} {
      allow read: if canV(who(), 'settings');
      allow create: if who().active && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
