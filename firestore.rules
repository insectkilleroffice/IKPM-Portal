rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }
    
    function isManagement() {
      return isSignedIn() && (getUserData().role == 'super_admin' || getUserData().role == 'management');
    }
    
    function isFinance() {
      return isSignedIn() && (getUserData().role == 'super_admin' || getUserData().role == 'management' || getUserData().role == 'finance');
    }
    
    function isOperations() {
      return isSignedIn() && (getUserData().role == 'super_admin' || getUserData().role == 'management' || getUserData().role == 'operations');
    }
    
    function isTechnician() {
      return isSignedIn() && getUserData().role == 'technician';
    }

    // System initialization (Only writable if not yet initialized, then permanently locked)
    match /system_config/{configId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/system_config/initialization);
      allow update, delete: if isSuperAdmin();
    }

    // User Accounts & Profiles
    match /users/{userId} {
      // Any authenticated user can read profiles within the organization
      allow read: if isSignedIn();
      // First admin creation or Super Admin modification
      allow create: if isSuperAdmin() || request.auth.uid == userId;
      // Users can update their own display name/avatar, but CANNOT elevate their own role or dataScope!
      allow update: if isSuperAdmin() || (
        request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'dataScope', 'isActive'])
      );
      allow delete: if isSuperAdmin();
    }

    // Corporate Companies & Individual Clients
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow write: if isManagement() || isSuperAdmin();
    }

    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow write: if isManagement() || isSuperAdmin() || getUserData().role == 'sales';
    }

    // Branches & Premises Sites
    match /branches/{branchId} {
      allow read: if isSignedIn();
      allow write: if isManagement() || isSuperAdmin();
    }

    match /sites/{siteId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && !isTechnician();
    }

    // CRM & Leads
    match /leads/{leadId} {
      allow read: if isSignedIn() && (getUserData().role in ['super_admin', 'management', 'sales', 'auditor']);
      allow create, update: if isSignedIn() && (getUserData().role in ['super_admin', 'management', 'sales']);
      allow delete: if isSuperAdmin();
    }

    // Proposals & Revision History
    match /proposals/{proposalId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (getUserData().role in ['super_admin', 'management', 'sales']);
      allow delete: if isSuperAdmin();
    }

    // Contracts & AMCs
    match /contracts/{contractId} {
      allow read: if isSignedIn();
      allow write: if isManagement() || isSuperAdmin();
    }

    // Service Jobs & Field Reports
    match /service_jobs/{jobId} {
      allow read: if isSignedIn();
      // PCO technicians can only update jobs assigned to their UID
      allow update: if isOperations() || (
        isTechnician() && request.auth.uid in resource.data.assignedTechnicianIds
      );
      allow create, delete: if isOperations();
    }

    // Invoices, Receipts & Financial Controls
    match /invoices/{invoiceId} {
      allow read: if isFinance();
      // Posted invoices are immutable — once posted, cannot be deleted or mutated client-side without credit note reversal
      allow create: if isFinance();
      allow update: if isFinance() && (
        resource.data.isPosted != true || 
        request.resource.data.status == 'void_reversed'
      );
      allow delete: if false; // Immutable audit compliance
    }

    match /payments/{paymentId} {
      allow read: if isFinance();
      allow create: if isFinance();
      allow update, delete: if false; // Financial receipts are immutable
    }

    match /tax_rules/{ruleId} {
      allow read: if isSignedIn();
      allow write: if isFinance();
    }

    // Documents (IKPM library + client attachments; files live in Cloudinary)
    match /documents/{documentId} {
      allow read: if isSignedIn() && !isTechnician();
      allow create, update: if isSignedIn() && (getUserData().role in ['super_admin', 'management', 'sales', 'operations', 'finance']);
      allow delete: if isManagement();
    }

    match /document_packs/{packId} {
      allow read: if isSignedIn();
      allow write: if isManagement();
    }

    // WhatsApp / Email outreach log (append-only)
    match /outreach_logs/{logId} {
      allow read: if isSignedIn() && (getUserData().role in ['super_admin', 'management', 'sales', 'auditor']);
      allow create: if isSignedIn() && request.resource.data.sentBy == request.auth.token.email;
      allow update, delete: if false;
    }

    // System Audit Logs (Append-only)
    match /audit_logs/{logId} {
      allow read: if isManagement() || getUserData().role == 'auditor';
      allow create: if isSignedIn();
      allow update, delete: if false; // Logs are strictly append-only
    }
  }
}
