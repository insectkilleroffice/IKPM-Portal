# Firebase Web Configuration Example
# Replace these placeholders with your actual Firebase project credentials
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# --- Cloudinary (document uploads) ---
# Console > Settings > Upload > Add upload preset > Signing mode: "Unsigned"
# Also enable: Settings > Security > "Allow delivery of PDF and ZIP files" (off by default on free plans)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=ikpm_unsigned
VITE_CLOUDINARY_FOLDER=ikpm-portal

# --- Sender identity used in WhatsApp / email message templates ---
VITE_COMPANY_NAME=Insect Killer Pest Management (IKPM)
VITE_COMPANY_PHONE=+92 300 0000000
VITE_COMPANY_EMAIL=info@insectkiller.pk
VITE_COMPANY_WEBSITE=www.insectkiller.pk

# --- Automatic sending (optional) ---
# Leave empty to use wa.me / mailto links (salesperson presses Send). Set to "/api" on Vercel to auto-send.
VITE_OUTREACH_API_URL=

# Optional: first-admin setup key (only usable before the portal is initialized)
# VITE_SETUP_KEY=choose-a-long-random-key

# --- Server-only secrets (Vercel > Project Settings > Environment Variables; NEVER prefix with VITE_) ---
# FIREBASE_API_KEY=same-as-VITE_FIREBASE_API_KEY (used to verify the signed-in user)
# CLOUDINARY_CLOUD_NAME=your-cloud-name (attachments are restricted to this account)
# WHATSAPP_TOKEN=permanent-system-user-token-from-Meta-Business
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_TEMPLATE_NAME=ikpm_documents_ready (optional, approved template with one {{1}} = client name)
# WHATSAPP_TEMPLATE_LANG=en
# FIREBASE_PROJECT_ID=your-project-id (used to read the sender's staff profile)
# RESEND_API_KEY=re_xxxxxxxx
# Domains verified in Resend. Staff whose business email is on these domains send emails AS themselves:
# EMAIL_SENDER_DOMAINS=insectkiller.pk
# Fallback for staff on other domains ("Name via IKPM", Reply-To = their business email):
# EMAIL_FROM=IKPM Portal <portal@insectkiller.pk>
# EMAIL_BCC_SENDER=true (BCC the sender so the email appears in their own mailbox)
